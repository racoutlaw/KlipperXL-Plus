+// RESULT-dwarf-txgate.md): the Dwarf drives the bus only inside a
+// window that opens after the end of a frame addressed to it, and the
+// receiver is off while it drives (Prusa-Firmware-Buddy
+// src/puppy/shared/hal/HAL_RS485.cpp:198, 252).  See the RS485 section.
 
 #include "autoconf.h" // CONFIG_SERIAL_BAUD
 #include "board/armcm_boot.h" // armcm_enable_irq
