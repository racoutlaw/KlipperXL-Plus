@@ -149,12 +157,19 @@
   // RTOIE: interrupt on receiver timeout (configurable via RTOR register).
   // Unlike IDLEIE (fixed 1-char = 43us threshold that SysTick gaps exceed),
   // RTOR uses 500 bit-times (~2.17ms) — immune to SysTick jitter.
+  // IDLEIE is on as well, but it is only honoured for a frame whose
+  // length cannot be counted (see "TX gating" below).
+  #define RS485_GATED 1
   #define CR1_FLAGS (USART_CR1_UE | USART_CR1_RE | USART_CR1_TE   \
                      | USART_CR1_RXNEIE                            \
                      | USART_CR1_RTOIE                             \
+                     | USART_CR1_IDLEIE                            \
                      | (8 << USART_CR1_DEAT_Pos)                   \
                      | (8 << USART_CR1_DEDT_Pos))
+  // The same with the receiver off: what CR1 holds while we drive the bus
+  #define CR1_FLAGS_TX (CR1_FLAGS & ~USART_CR1_RE)
 #else
+  #define RS485_GATED 0
   #define CR1_FLAGS (USART_CR1_UE | USART_CR1_RE | USART_CR1_TE   \
                      | USART_CR1_RXNEIE)
 #endif
@@ -185,12 +200,154 @@
  * frame boundaries mid-frame — consuming data bytes as "addresses".
  * RTOR with 500 bit-times requires 2.17ms of silence, which only
  * occurs between actual frames (never mid-frame from SysTick).
+ *
+ * TX gating (task D).  Klipper's serial driver otherwise transmits the
+ * moment console_sendf() has queued a message (src/generic/
+ * serial_irq.c:94-114), which on a shared half-duplex bus collides
+ * with whoever is driving it, and the XLBuddy only listens for a
+ * reply right after it has addressed a Dwarf (research/multitool/
+ * bridge-era-source/modbus_stm32f4.c, the capture after the write:
+ * first byte within 3ms, then until 500us of silence, at most 192
+ * bytes / 15ms).  Prusa's own Dwarf firmware transmits only in reply
+ * to a frame carrying its address (ModbusTask.cpp:80-81) and turns the
+ * receiver off while it drives (HAL_RS485.cpp:198, back on at
+ * transmit-complete, :252).  So:
+ *
+ *   closed --(end of a frame addressed to us)--> opening
+ *   opening --(TX_TURNAROUND_US)--> open: if output is queued, drive;
+ *   open, nothing to send for TX_OPEN_MAX_US --> closed
+ *   open, driving: receiver off; stop at TX_WINDOW_MAX_BYTES /
+ *     TX_WINDOW_MAX_US; when the buffer runs dry wait for TC, receiver
+ *     on, then TX_GRACE_US for more output, else closed.
+ *
+ * Output queued while closed stays in the transmit buffer (96 bytes,
+ * serial_irq.c:20; what does not fit is dropped there, as in stock
+ * Klipper) and goes out in the next window - the host polls an idle
+ * Dwarf for exactly that.  Where a window ends mid-message the rest
+ * follows in the next window; the host's serialqueue reassembles.
+ *
+ * The end of the XLBuddy's frame is found by counting: the frame is
+ * [address][optional 0x7e][one Klipper block] and a block's first byte
+ * is its length (5..64, src/command.h:46-47), so the last byte is
+ * known without any timing.  Only a frame with no block - the host's
+ * idle poll, a bare 0x7e - ends on the IDLE flag (one character of
+ * silence); a gap in the XLBuddy's output right after a sync byte
+ * would open the window early, which costs that one (rare, resend)
+ * frame and nothing else.
+ *
+ * In accept-all mode (my_address == 0, before set_serial_address) only
+ * address bytes with bit 7 set are taken: that is the bridge's
+ * address space (0x81-0x85, comment above), and it keeps an unlocked
+ * Dwarf from parsing a MODBUS or bootloader frame for another device
+ * as Klipper data and from opening a window after it.  This is a task
+ * D addition, not in the recovered diff.
  ****************************************************************/
 
-#if CONFIG_MACH_STM32G0 && CONFIG_STM32_SERIAL_USART1
+#if RS485_GATED
 static volatile uint8_t expect_address; // 1 when next RX byte is address
 static volatile uint8_t my_address;     // 0 = accept all, else match required
 static volatile uint8_t muted;          // 1 = wrong address, drop until RTOR
+
+// Frame-end tracking for the frame being received
+static uint8_t in_frame;     // address matched, data bytes may follow
+static uint8_t frame_any;    // at least one data byte seen
+static uint8_t frame_len;    // block length byte seen (0: none yet)
+static uint8_t frame_got;    // data bytes of that block seen so far
+
+// TX window
+enum { WIN_CLOSED, WIN_OPENING, WIN_OPEN };
+static volatile uint8_t win_state;
+static volatile uint8_t tx_active;   // driver enabled, receiver off
+static volatile uint8_t tx_pending;  // output queued while not allowed
+static volatile uint8_t win_cap;     // window cap reached, stop driving
+static uint32_t win_open_time;
+static uint16_t win_bytes;
+static uint_fast8_t win_timer_event(struct timer *t);
+static struct timer win_timer = { .func = win_timer_event };
+
+#define TX_TURNAROUND_US      100   // XLBuddy: TC -> rs485_rx_enable -> flush, ~15us
+#define TX_OPEN_MAX_US       2500   // XLBuddy waits 3000us for a first byte
+#define TX_GRACE_US           300   // XLBuddy ends the capture after 500us of silence
+#define TX_WINDOW_MAX_US    10000   // XLBuddy caps a capture at 15000us
+#define TX_WINDOW_MAX_BYTES   192   // XLBuddy rx_buf[192]
+
+static void
+win_timer_set(uint32_t waketime)
+{
+    // Never schedule into the past: sched_add_timer() shuts the MCU
+    // down on that ("Timer too close", sched.c:93-94)
+    uint32_t soonest = timer_read_time() + timer_from_us(20);
+    if (timer_is_before(waketime, soonest))
+        waketime = soonest;
+    sched_del_timer(&win_timer);
+    win_timer.waketime = waketime;
+    sched_add_timer(&win_timer);
+}
+
+static void
+win_close(void)
+{
+    sched_del_timer(&win_timer);
+    win_state = WIN_CLOSED;
+    win_cap = 0;
+    // The exchange is over: whatever comes next on the bus starts
+    // with an address byte, whether or not RTOR got to say so (the
+    // receiver was off while we drove).
+    expect_address = 1;
+    muted = 0;
+    in_frame = 0;
+}
+
+// Start driving the bus: receiver off (HAL_RS485.cpp:198), TXE irq on
+static void
+tx_start(void)
+{
+    tx_active = 1;
+    tx_pending = 0;
+    USARTx->CR1 = CR1_FLAGS_TX | USART_CR1_TXEIE;
+}
+
+// End of an addressed frame received: open the window after the
+// XLBuddy has had time to release the bus
+static void
+frame_end(void)
+{
+    frame_len = frame_got = frame_any = 0;
+    if (win_state != WIN_CLOSED)
+        return;
+    win_state = WIN_OPENING;
+    win_timer_set(timer_read_time() + timer_from_us(TX_TURNAROUND_US));
+}
+
+static uint_fast8_t
+win_timer_event(struct timer *t)
+{
+    if (win_state == WIN_OPENING) {
+        win_state = WIN_OPEN;
+        win_open_time = timer_read_time();
+        win_bytes = 0;
+        if (tx_pending) {
+            tx_start();
+            t->waketime = win_open_time + timer_from_us(TX_WINDOW_MAX_US);
+        } else {
+            t->waketime = win_open_time + timer_from_us(TX_OPEN_MAX_US);
+        }
+        return SF_RESCHEDULE;
+    }
+    if (win_state == WIN_OPEN && tx_active) {
+        // Time cap while driving: the TXE handler stops at the next byte
+        // and the TC handler closes the window
+        win_cap = 1;
+        return SF_DONE;
+    }
+    // Start deadline or grace period passed with nothing to send
+    win_state = WIN_CLOSED;
+    win_cap = 0;
+    expect_address = 1;
+    muted = 0;
+    in_frame = 0;
+    return SF_DONE;
+}
 #endif
 
