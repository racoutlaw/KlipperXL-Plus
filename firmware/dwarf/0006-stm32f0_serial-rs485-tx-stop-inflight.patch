--- a/src/stm32/stm32f0_serial.c
+++ b/src/stm32/stm32f0_serial.c
@@ -258,6 +258,7 @@
 enum { WIN_CLOSED, WIN_OPENING, WIN_OPEN };
 static volatile uint8_t win_state;
 static volatile uint8_t tx_active;   // driver enabled, receiver off
+static volatile uint8_t tx_inflight; // a byte was written since the last TC
 static volatile uint8_t tx_pending;  // output queued while not allowed
 static volatile uint8_t win_cap;     // window cap reached, stop driving
 static uint32_t win_open_time;
@@ -312,7 +313,7 @@
 win_shutdown(void)
 {
     irqstatus_t flag = irq_save();
-    tx_active = 0;
+    tx_active = tx_inflight = 0;
     USARTx->CR1 = CR1_FLAGS;
     win_close();
     tx_pending = 1;
@@ -329,6 +330,37 @@
     USARTx->CR1 = CR1_FLAGS_TX | USART_CR1_TXEIE;
 }
 
+// End of our transmission: receiver back on (HAL_RS485.cpp:252), then
+// close the window at its cap or give the main loop TX_GRACE_US to add
+// to this reply.
+static void
+tx_end(void)
+{
+    tx_active = tx_inflight = 0;
+    USARTx->CR1 = CR1_FLAGS;
+    if (win_cap || win_bytes >= TX_WINDOW_MAX_BYTES)
+        win_close();
+    else
+        win_timer_set(timer_read_time() + timer_from_us(TX_GRACE_US));
+}
+
+// Stop feeding TDR.  KlipperXL+ (2026-10-03): wait for TC only if a byte
+// is actually on its way.  TC is cleared at the end of every transmission
+// and is set again only by a new one, so waiting for it with nothing
+// written since leaves tx_active set and the receiver off for good - the
+// Dwarf is deaf and mute (printer: diagnostic lamp, "blinking" = tx_active
+// with receiver off).  It happened when serial_enable_tx_irq() restarted
+// TX for data the TXE irq had already sent; once the window time cap then
+// set win_cap, every later message only set tx_pending.
+static void
+tx_stop(void)
+{
+    if (tx_inflight)
+        USARTx->CR1 = CR1_FLAGS_TX | USART_CR1_TCIE;
+    else
+        tx_end();
+}
+
 // End of an addressed frame received: open the window after the
 // XLBuddy has had time to release the bus
 static void
@@ -436,16 +468,17 @@
         if (win_cap || win_bytes >= TX_WINDOW_MAX_BYTES) {
             // Window cap: the rest goes out in the next window
             tx_pending = 1;
-            USARTx->CR1 = CR1_FLAGS_TX | USART_CR1_TCIE;
+            tx_stop();
         } else {
             uint8_t data;
             if (serial_get_tx_byte(&data)) {
-                // Buffer empty: keep the receiver off until the last
-                // byte has left the shift register (TC)
-                USARTx->CR1 = CR1_FLAGS_TX | USART_CR1_TCIE;
+                // Buffer empty: receiver stays off until the last byte
+                // has left the shift register (TC) - if one was sent
+                tx_stop();
             } else {
                 USARTx->TDR = data;
                 win_bytes++;
+                tx_inflight = 1;
             }
         }
 #else
@@ -464,14 +497,8 @@
         if (USARTx->CR1 & USART_CR1_TXEIE)
             // More output was queued meanwhile and TX resumed
             goto tx_done;
-        // Last byte is on the wire: receiver back on (HAL_RS485.cpp:252)
-        tx_active = 0;
-        USARTx->CR1 = CR1_FLAGS;
-        if (win_cap || win_bytes >= TX_WINDOW_MAX_BYTES)
-            win_close();
-        else
-            // Give the main loop a moment to add to this reply
-            win_timer_set(timer_read_time() + timer_from_us(TX_GRACE_US));
+        // Last byte is on the wire
+        tx_end();
     }
 tx_done:;
 #endif
